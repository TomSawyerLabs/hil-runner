# Pinned inputs to the image. Bump these deliberately; the build checks every hash.

# GitHub Actions runner. GitHub refuses jobs to runners below its minimum version, and the
# image is rebuilt rather than self-updated, so keep this current.
RUNNER_VERSION=2.338.2
RUNNER_SHA256=670adb2f268fe21dcbb58b3db0e0aa9d5b3bddfe2c651481336e561ff86de945

# cpp-coveralls, which dfu-programmer's workflow runs as `coveralls`.
CPP_COVERALLS_VERSION=0.4.2

# Public SSH keys for the `hil` maintenance user.
ADMIN_KEYS_URL=https://github.com/cinderblock.keys
