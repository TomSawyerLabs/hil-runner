[Unit]
Description=One-job GitHub Actions runner (JIT config from the broker)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target hil-hat-safe.service

[Service]
User=runner
WorkingDirectory=/opt/actions-runner
ExecStart=/usr/local/libexec/hil/runner-start
# One job per boot: whatever happened, start over from the image. "+" runs it as root.
ExecStopPost=+/usr/bin/systemctl --no-block reboot
# A job that outlives this is wedged; reboot it.
RuntimeMaxSec=3h
Restart=no

[Install]
WantedBy=multi-user.target
